          "stringUnit" : {
            "state" : "translated",
            "value" : "Watermarkly benötigt Zugriff auf Ihre Fotos, um Wasserzeichen hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watermarkly needs access to your photos so you can add watermarks."
