    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watermarkly benötigt Zugriff, um fotos mit Wasserzeichen in Ihrer Mediathek zu speichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watermarkly needs access to save watermarked photos to your library."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watermarkly a besoin d’accéder à la photothèque pour enregistrer vos photos avec filigrane."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watermarkly a besoin d’accéder à la photothèque pour enregistrer vos photos avec filigrane."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透かし付き写真をライブラリに保存するために、Watermarklyはアクセスを必要とします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "워터마크가 적용된 사진을 보관함에 저장하려면 Watermarkly 접근이 필요합니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watermarkly 需要取用權限，才能將浮水印照片儲存到圖庫。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
