    "purchase_benefits": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Unlimited batch exports\n• Select unlimited photos\n• All watermark modes forever"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Exports par lot illimités\n• Sélection illimitée de photos\n• Tous les modes de filigrane à vie"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
